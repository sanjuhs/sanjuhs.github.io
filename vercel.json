{
  "redirects": [
    {
      "source": "/play",
      "destination": "/game-builds/Necroknightv2/web/",
      "permanent": false
    },
    {
      "source": "/necro-knight",
      "destination": "/game-builds/Necroknightv2/web/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/game-builds/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" }
      ]
    },
    {
      "source": "/game.html",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" }
      ]
    }
  ]
}
